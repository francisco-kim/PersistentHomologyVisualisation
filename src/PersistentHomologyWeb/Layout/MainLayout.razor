@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

<div class="app-shell">
    <header class="app-header">
        <div class="app-title">
            <span class="app-mark"></span>
            <span>Persistent homology</span>
            <a class="app-byline" href="https://francisco-kim.github.io"
               target="_blank" rel="noopener">by Francisco Kim</a>
        </div>
        @* Plain anchors with the active state worked out here rather than
           NavLinks: the explanations live under /boundary as well as at the
           root, so NavLink's prefix matching would light up "Boundary
           operators" and "Explanation" at the same time. Blazor's router still
           intercepts these, so they are ordinary in-app navigation. *@
        <nav class="app-nav">
            <a href="" class="@ActiveIf(Route.Length == 0)">Simulator</a>
            <a href="boundary" class="@ActiveIf(Route == "boundary")">Boundary operators</a>
            @* Follows whichever tab you are on. Navigates in place rather than
               popping a browser tab: the explanations carry their own strip for
               switching between the two, so they behave like a third section of
               the app, and this nav is the way back out of them. *@
            <a href="@ExplanationHref" class="@ActiveIf(OnExplanation)">Explanation</a>
        </nav>
    </header>

    <main class="app-main">
        @Body
    </main>

    <footer class="app-footer">
        Growing balls around points until pieces merge and holes appear —
        real topological data analysis running entirely in your browser.
        <a href="https://github.com/francisco-kim/PersistentHomologyVisualisation" target="_blank" rel="noopener">Source</a>
    </footer>
</div>

@code {
    // The layout outlives page navigation, so the nav link has to be told when
    // the route changed or it would keep pointing at the previous tab's
    // explanation.
    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => StateHasChanged();

    // Query and fragment stripped so a link never fails to light up because of
    // something hanging off the end of the URL.
    private string Route =>
        Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');

    // Standing on an explanation already, the link keeps you there rather than
    // throwing you across to the other one - the strip on the page itself is
    // what switches between them.
    private string ExplanationHref => InBoundarySection ? "boundary/explainer" : "explainer";

    private bool InBoundarySection =>
        Route.StartsWith("boundary", StringComparison.OrdinalIgnoreCase);

    private bool OnExplanation =>
        Route.Equals("explainer", StringComparison.OrdinalIgnoreCase) ||
        Route.Equals("boundary/explainer", StringComparison.OrdinalIgnoreCase);

    private static string ActiveIf(bool active) => active ? "active" : "";

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
