@page "/boundary"
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject BoundaryExplorerState State
@using PersistentHomologyWeb.Interop

<h1 class="page-title">Boundary operators</h1>
<p class="page-intro">
    A small complex in three dimensions, and the matrices that encode it. Click
    anything — a row, a column, or the shape itself — to see which simplex it
    stands for. Transpose the matrices and the same click tells you what a
    simplex is a face <em>of</em> instead of what it is bounded <em>by</em>.
</p>

<div class="sim-layout">
    <section class="lattice-panel">
        <p class="panel-caption">
            Drag to rotate — click a vertex, edge, face, or the dot at a
            tetrahedron's centre to select it.
        </p>
        <div class="canvas-stack">
            <canvas id="@CanvasId" class="ph-canvas ph-canvas-3d"></canvas>
        </div>
        <div class="readout-row">
            <div class="readout">
                <span class="readout-label">vertices</span>
                <span class="readout-value">@State.Complex.Count(0)</span>
            </div>
            <div class="readout">
                <span class="readout-label">edges</span>
                <span class="readout-value">@State.Complex.Count(1)</span>
            </div>
            <div class="readout">
                <span class="readout-label">triangles</span>
                <span class="readout-value">@State.Complex.Count(2)</span>
            </div>
            <div class="readout">
                <span class="readout-label">tetrahedra</span>
                <span class="readout-value">@State.Complex.Count(3)</span>
            </div>
            <div class="readout" title="Euler characteristic: the counts to the left, alternating. It also equals the Betti numbers alternating — both sums are worked out beside it.">
                <span class="readout-label" data-katex="\chi"></span>
                <span class="readout-value">@Signed(State.Complex.EulerCharacteristic)</span>
            </div>

            @* The same number counted twice over: once off the simplices, once
               off the holes. Shown live because the equality is far more
               convincing when both sides move under the fill-level control and
               keep agreeing.

               Run along one line rather than stacked a sum per line. Stacking
               put the two sums digit above digit, which is the better way to
               read them against each other, but it cost three lines of a panel
               that has to share a row with the counts - and the sums are short
               enough that following them across is no hardship. Each sum still
               holds together as a unit: they wrap between one another, never
               inside one.

               Rides in the readout row, in the space the counts leave to their
               right, rather than in a block of its own: the first sum is those
               very counts alternating, so it belongs level with them rather
               than somewhere further down the panel. *@
            <div class="euler-panel">
                <span class="euler-label">Euler characteristic</span>
                <div class="euler-identity">
                    <span class="euler-symbol" data-katex="\chi"></span>
                    <span class="euler-op">=</span>
                    <span class="euler-sum">@EulerFromCounts()</span>
                    <span class="euler-op">=</span>
                    <span class="euler-sum">@EulerFromBetti()</span>
                    <span class="euler-op">=</span>
                    <span class="euler-sum euler-total">@Signed(State.Complex.EulerCharacteristic)</span>
                </div>
                <span class="euler-note">
                    alternating simplices, then alternating Betti numbers
                </span>
            </div>
        </div>
        <p class="control-hint">
            @if (State.SelectedSimplex is { } selected)
            {
                <span>
                    Selected <strong>@DimensionName(selected.Dimension) @selected.Label</strong> —
                    @if (State.RelatedIndices.Length == 0)
                    {
                        <span>@(State.Transposed ? "it is the face of nothing above it, so its coboundary is zero." : "it has no faces below it.")</span>
                    }
                    else
                    {
                        <span>
                            highlighted with the @State.RelatedIndices.Length
                            @(State.Transposed ? "simplices it is a face of" : "faces it is bounded by").
                        </span>
                    }
                </span>
            }
            else
            {
                <span>Nothing selected.</span>
            }
        </p>
    </section>

    <div class="sim-side">
        <aside class="controls">
            <div class="control-group">
                <label class="control-label" for="preset-select">Complex</label>
                <select id="preset-select" value="@State.Preset" @onchange="OnPresetChanged">
                    @foreach (var kind in Enum.GetValues<BoundaryPresetKind>())
                    {
                        <option value="@kind">@PresetName(kind)</option>
                    }
                </select>
                <span class="control-hint">@PresetHint(State.Preset)</span>
            </div>

            <div class="control-group">
                <span class="control-label">Fill level</span>
                <div class="segmented">
                    @foreach (var level in Enum.GetValues<FillLevel>())
                    {
                        var captured = level;
                        <button type="button"
                                class="segmented-option @(State.FillLevel == captured ? "segmented-option-active" : "")"
                                @onclick="() => OnFillLevelChanged(captured)">
                            @captured.ToString().ToLowerInvariant()
                        </button>
                    }
                </div>
                <span class="control-hint">
                    How far up the complex is filled in — the same points, with
                    triangles and then tetrahedra added.
                </span>
            </div>

            <div class="control-group">
                <span class="control-label">View</span>
                <label class="check-label">
                    <input type="checkbox" checked="@State.Transposed" @onchange="OnTransposedChanged" />
                    transpose (show the coboundary)
                </label>
                <label class="check-label">
                    <input type="checkbox" checked="@(State.Coefficients == Coefficients.Mod2)"
                           @onchange="OnCoefficientsChanged" />
                    collapse signs to <span data-katex="\mathbb{Z}/2"></span>
                </label>
            </div>

            <div class="control-group">
                <span class="control-label">Ranks and Betti numbers</span>
                <div class="matrix-scroll">
                    <table class="betti-table">
                        <thead>
                            <tr>
                                <th scope="col"><span data-katex="k"></span></th>
                                <th scope="col"><span data-katex="n_k"></span></th>
                                <th scope="col"><span data-katex="\operatorname{rank}\partial_k"></span></th>
                                <th scope="col"><span data-katex="\dim\ker\partial_k"></span></th>
                                <th scope="col"><span data-katex="\operatorname{rank}\partial_{k+1}"></span></th>
                                <th scope="col"><span data-katex="\beta_k"></span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var info in State.Homology)
                            {
                                <tr>
                                    <td>@info.Dimension</td>
                                    <td>@info.SimplexCount</td>
                                    <td>@info.BoundaryRank</td>
                                    <td>@info.CycleRank</td>
                                    <td>@info.BoundaryRankAbove</td>
                                    <td class="betti-value">@info.Betti</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="betti-summary">
                    <span class="betti-summary-value">
                        <span data-katex="\beta"></span> = (@BettiList())
                    </span>

                    @* Built in markup rather than joined into one string, so the
                       beta_3 entry can be set in KaTeX like every other symbol
                       on the page instead of being spelled with a Unicode
                       subscript. *@
                    <span class="betti-summary-note">
                        @for (var index = 0; index < State.Homology.Count; index++)
                        {
                            var info = State.Homology[index];

                            if (index > 0)
                            {
                                <text>, </text>
                            }

                            if (info.Dimension >= 3)
                            {
                                <span data-katex="\beta_3"></span>
                                <text> (3D voids)</text>
                            }
                            else
                            {
                                <text>@BettiName(info.Dimension)</text>
                            }
                        }
                    </span>

                </div>
            </div>

        </aside>
    </div>
</div>

<div class="matrix-strip">
    @for (int degree = 1; degree <= State.HighestDisplayedDegree; degree++)
    {
        int k = degree;
        <BoundaryMatrix Matrix="State.Displayed(k)"
                        Rows="State.DisplayedRows(k)"
                        Columns="State.DisplayedColumns(k)"
                        Degree="k"
                        Transposed="State.Transposed"
                        Coefficients="State.Coefficients"
                        Selection="State.Selection"
                        RelatedDimension="State.RelatedDimension"
                        RelatedIndices="State.RelatedIndices"
                        OnSelect="OnMatrixSelect" />
    }

    @* Degree 0 trails the strip rather than leading it, and gets a bar of its
       own rather than a card in the row. It is the zero map at every preset and
       every fill level, so it never rewards a glance and does not deserve a slot
       beside the matrices that do change - but it has no table to show either,
       only a sentence, so a bar wastes none of the height a card would.

       Kept inside the strip so it wraps onto its own line underneath and
       inherits the row's width, rather than sitting after the strip where
       nothing would tie the two together. *@
    <div class="matrix-zero-bar">
        <BoundaryMatrix Matrix="State.Displayed(0)"
                        Rows="State.DisplayedRows(0)"
                        Columns="State.DisplayedColumns(0)"
                        Degree="0"
                        Transposed="State.Transposed"
                        Coefficients="State.Coefficients" />
    </div>
</div>

@if (State.DoubleBoundary is { } expansion)
{
    <section class="double-boundary">
        <h2>Why <span data-katex="\partial \circ \partial = 0"></span>, on this simplex</h2>
        <p>
            Take the boundary of <strong>@expansion.Simplex.Label</strong>, then take
            the boundary of that. Every face below turns up exactly twice —
            matching colours mark the pairs — so all @(expansion.PairCount * 2)
            terms
            @if (Mod2)
            {
                <text>
                    fall in @(expansion.PairCount) pairs, and over
                    <span data-katex="\mathbb{Z}/2"></span> a face counted twice is
                    a face counted zero times.
                </text>
            }
            else
            {
                <text>annihilate: the two copies carry opposite signs.</text>
            }
        </p>
        <div class="expansion">
            @foreach (var row in expansion.Rows)
            {
                <div class="expansion-row">
                    <span class="expansion-face">
                        @Sign(row.Sign) ∂@(row.Face.Label)
                    </span>
                    <span class="expansion-equals">=</span>
                    <span class="expansion-terms">
                        @foreach (var term in row.Terms)
                        {
                            <span class="expansion-term pair-@(term.CancellingPair % 6)">
                                @Sign(term.Sign)@term.Simplex.Label
                            </span>
                        }
                    </span>
                </div>
            }
            <div class="expansion-row expansion-total">
                <span class="expansion-face">total</span>
                <span class="expansion-equals">=</span>
                <span class="expansion-terms"><strong>0</strong></span>
            </div>
        </div>
        <p class="control-hint">
            @if (Mod2)
            {
                <text>
                    The identity still holds here, but its mechanism has gone:
                    with no signs there is nothing to watch cancel, only pairs
                    adding to an even number. Untick <strong>collapse signs</strong>
                    to get it back.
                </text>
            }
            else
            {
                <text>
                    Tick <strong>collapse signs</strong> and the identity still
                    holds, but the mechanism vanishes: without signs there is
                    nothing to see cancelling, only pairs adding to an even number.
                </text>
            }
        </p>
    </section>
}
else
{
    <section class="double-boundary double-boundary-idle">
        <p class="control-hint">
            Select a triangle or a tetrahedron — in a matrix or in the shape — to
            see <span data-katex="\partial(\partial\sigma) = 0"></span> worked out
            term by term.
        </p>
    </section>
}

<a class="explainer-link" href="boundary/explainer">
    <span class="explainer-link-label">Read the explanation</span>
    <span class="explainer-link-text">
        Chains and orientation, the alternating-sign boundary formula, why
        <span data-katex="\partial_0"></span> is empty,
        <span data-katex="\partial \circ \partial = 0"></span>, Betti numbers as
        ranks, <span data-katex="\chi"></span> counted two ways, and what
        transposing the matrices means &mdash; the coboundary, the discrete
        gradient, and cohomology.
    </span>
</a>

@code {
    private const string CanvasId = "ph-complex3d";

    private IJSObjectReference? _module;
    private DotNetObjectReference<BoundaryOperators>? _selfReference;
    private bool _moduleReady;
    private bool _needsKatex = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Complex3DInterop.EnsureModuleLoadedAsync();
            _moduleReady = true;

            Complex3DInterop.InitCanvas(CanvasId, BoundaryExplorerState.CanvasWidth, BoundaryExplorerState.CanvasHeight);
            PushComplex();

            // Loaded a second time via IJSRuntime for the same reason as the
            // simulator's rAF loop: attachPicker takes a DotNetObjectReference,
            // which cannot cross through [JSImport]. ES modules are singletons
            // per URL, so both imports share the module's state.
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/phComplex3d.js");
            _selfReference = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("attachPicker", CanvasId, _selfReference);

            // Typeset on the *next* pass, not this one: StateHasChanged is
            // about to re-render the matrix cards, which would discard any
            // KaTeX injected into their captions now.
            _needsKatex = true;
            StateHasChanged();
            return;
        }

        // KaTeX is only re-typeset when something actually changed the maths on
        // the page - the matrix captions flip between partial and delta. Doing
        // it on every render would re-typeset the whole document on each
        // selection click.
        if (_needsKatex)
        {
            _needsKatex = false;
            await JS.InvokeVoidAsync("renderKatex");
        }
    }

    [JSInvokable]
    public void OnSimplexPicked(int dimension, int index)
    {
        if (dimension < 0) State.ClearSelection();
        else State.Select(dimension, index);

        AfterSelectionChanged();
        StateHasChanged();
    }

    private void OnMatrixSelect((int Dimension, int Index) target)
    {
        // Clicking the current selection again clears it, so there is a way
        // back to the unhighlighted shape without hunting for empty space.
        if (State.Selection == target) State.ClearSelection();
        else State.Select(target.Dimension, target.Index);

        AfterSelectionChanged();
    }

    private void AfterSelectionChanged()
    {
        PushHighlight();

        // Selecting swaps the whole d.d = 0 panel in or out, and that panel
        // carries its own KaTeX - which would otherwise never be typeset,
        // since it did not exist on any earlier render.
        _needsKatex = true;
    }

    private void OnPresetChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<BoundaryPresetKind>(e.Value?.ToString(), out var kind))
        {
            State.Preset = kind;
            PushComplex();
            _needsKatex = true;
        }
    }

    private void OnFillLevelChanged(FillLevel level)
    {
        State.FillLevel = level;
        PushComplex();
        _needsKatex = true;
    }

    private void OnTransposedChanged(ChangeEventArgs e)
    {
        State.Transposed = e.Value is bool transposed && transposed;
        PushHighlight();
        _needsKatex = true;
    }

    private void OnCoefficientsChanged(ChangeEventArgs e)
    {
        State.Coefficients = e.Value is bool mod2 && mod2 ? Coefficients.Mod2 : Coefficients.Integer;

        // Only the highlight, not the whole complex: the coefficients change the
        // matrix entries, never the geometry.
        PushHighlight();
        _needsKatex = true;
    }

    private void PushComplex()
    {
        if (!_moduleReady) return;
        Complex3DInterop.SetComplex(
            CanvasId,
            State.VertexXyz,
            State.EdgePairs,
            State.TriangleTriples,
            State.TetrahedronQuads,
            State.FillLevel == FillLevel.Solid);
        PushHighlight();
    }

    private void PushHighlight()
    {
        if (!_moduleReady) return;
        Complex3DInterop.SetHighlight(
            CanvasId,
            State.Selection?.Dimension ?? -1,
            State.Selection?.Index ?? -1,
            State.RelatedDimension,
            State.RelatedIndices);
    }

    private bool Mod2 => State.Coefficients == Coefficients.Mod2;

    // Over Z/2 the coefficient is 1, not +1: writing a sign there would imply a
    // choice of orientation that the field does not have. The terms are still a
    // formal sum, so they are still joined by "+".
    private string Sign(int sign) => Mod2 ? "+" : sign > 0 ? "+" : "−";

    private string BettiList() => string.Join(", ", State.Homology.Select(info => info.Betti));

    // Both sides of chi run to the complex's top populated dimension, so the two
    // sums always have the same number of terms and can be read off against each
    // other. Stopping there rather than always writing four terms keeps the
    // frame level from trailing a meaningless "+ 0 - 0".
    private string EulerFromCounts() => AlternatingSum(
        Enumerable.Range(0, State.Complex.MaxDimension + 1).Select(State.Complex.Count));

    private string EulerFromBetti() => AlternatingSum(State.Homology.Select(info => info.Betti));

    // A typographic minus, matching the one separating the terms of the sums.
    // The default ToString would put a hyphen next to them.
    private static string Signed(int value) => value < 0 ? $"−{-value}" : value.ToString();

    private static string AlternatingSum(IEnumerable<int> terms) =>
        string.Concat(terms.Select((value, k) =>
            k == 0 ? value.ToString() : (k % 2 == 1 ? " − " : " + ") + value));

    // Named per entry rather than as a fixed "pieces, loops, cavities": the
    // number of Betti numbers follows the fill level (two at frame, four at
    // solid), and a caption listing three names beside two or four numbers
    // invites the reader to line them up wrongly.
    //
    // Dimension 3 has no plain-English name here and is written out as
    // "beta_3 (3D voids)" by the caption itself: it names the class by its
    // dimension, the same convention the explainer uses when it calls beta_k
    // the count of k-dimensional holes. Worth spelling out even though nothing
    // here can have one - beta_3 is zero for anything that fits in three-space
    // - because a trailing zero with no name attached looks like a defect.
    private static string BettiName(int dimension) => dimension switch
    {
        0 => "pieces",
        1 => "loops",
        _ => "cavities"
    };

    private static string DimensionName(int dimension) => dimension switch
    {
        0 => "vertex",
        1 => "edge",
        2 => "triangle",
        _ => "tetrahedron"
    };

    private static string PresetName(BoundaryPresetKind kind) => kind switch
    {
        BoundaryPresetKind.Tetrahedron => "Tetrahedron",
        BoundaryPresetKind.TetrahedronWithOpenTriangle => "Tetrahedron + open triangle",
        _ => kind.ToString()
    };

    private static string PresetHint(BoundaryPresetKind kind) => kind switch
    {
        BoundaryPresetKind.Tetrahedron =>
            "Four points, maximally symmetric — the matrices in the explanation below are this one.",
        BoundaryPresetKind.TetrahedronWithOpenTriangle =>
            "A fifth point joined to 2 and 3, closing a loop whose face is never filled — so β₁ = 1 at every fill level.",
        _ => string.Empty
    };

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("detachPicker", CanvasId);
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
        _selfReference?.Dispose();
    }
}
